{
  "name": "rasp-meeting-clock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "bundle:pi": "npm run build && bash scripts/build-pi-bundle.sh",
    "preview:pi": "npm run bundle:pi && node server/lanPreview.mjs",
    "deploy:pi": "bash scripts/deploy-to-pi.sh",
    "install:pi": "bash scripts/install-pi.sh",
    "install:mac": "bash scripts/install-mac-companion.sh",
    "update:pi": "bash scripts/update-pi.sh",
    "start": "node server/index.mjs",
    "test": "vitest run src && node --test server/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "terser": "^5.51.2",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  }
}
